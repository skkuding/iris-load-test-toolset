{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codedang.dev/schemas/iris-benchmark-fixture-manifest.json",
  "title": "Iris benchmark fixture manifest",
  "description": "Pins the exact sanitized testcase objects uploaded to the benchmark S3 bucket.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "source", "problems", "objects"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "string",
      "description": "Script that produced this manifest."
    },
    "source": {
      "type": "string",
      "description": "Provenance of the sanitized fixture set."
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+$"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem_id",
          "s3_key",
          "relative_path",
          "sha256",
          "size",
          "content_type",
          "hidden"
        ],
        "properties": {
          "problem_id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "s3_key": {
            "type": "string",
            "pattern": "^[0-9]+/[^/]+\\.(in|out)$"
          },
          "relative_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "content_type": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
