# Read-only benchmark database credentials.
#
# The value is generated by Terraform, stored in Secrets Manager, and consumed
# at runtime by scripts/aws/bootstrap-benchmark-db-role.sh. It is never written
# to a committed file, .env file, or Terraform output.
resource "aws_secretsmanager_secret" "readonly_db" {
  name                    = local.readonly_secret_name
  description             = "Read-only benchmark database credentials for codedang-iris-benchmark."
  kms_key_id              = aws_kms_key.benchmark.arn
  recovery_window_in_days = 30

  tags = local.common_tags
}

resource "aws_secretsmanager_secret_version" "readonly_db" {
  secret_id = aws_secretsmanager_secret.readonly_db.id

  secret_string = jsonencode({
    engine   = "postgres"
    username = var.readonly_db_username
    password = random_password.readonly_db.result
    host     = aws_db_instance.benchmark.address
    port     = aws_db_instance.benchmark.port
    dbname   = var.app_db_name
  })
}
