{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformBackendStateObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::__STATE_BUCKET__/__STATE_KEY__"
      ]
    },
    {
      "Sid": "TerraformBackendListOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::__STATE_BUCKET__"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "__STATE_KEY__",
            "__STATE_KEY__/*",
            "__VPC_STATE_KEY__"
          ]
        }
      }
    },
    {
      "Sid": "ReadVpcRemoteStateObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::__STATE_BUCKET__/__VPC_STATE_KEY__"
      ]
    },
    {
      "Sid": "TerraformStateLockTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive"
      ],
      "Resource": [
        "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/__LOCK_TABLE__"
      ]
    },
    {
      "Sid": "DetermineCallerIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
