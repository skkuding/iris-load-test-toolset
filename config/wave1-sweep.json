    },
    "ladder-8": {
      "suite": "judger",
      "workers": 8,
      "repetitions": 50,
      "cpuList": "0-31",
      "numaPolicy": "bind"
    },
    "ladder-16": {
      "suite": "judger",
      "workers": 16,
      "repetitions": 50,
      "cpuList": "0-31",
      "numaPolicy": "bind"
    },
    "ladder-30": {
      "suite": "judger",
