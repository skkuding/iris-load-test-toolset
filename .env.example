# Iris benchmark environment template.
#
# Copy to `.env` (never commit `.env`) and fill in any approved addresses or
# discovered identifiers. This template contains NO credentials, secret values,
# tokens, or resolved database connection strings. Reference secrets by name or
# ARN and fetch them at runtime from AWS Secrets Manager.
#
# Values below point at the dedicated codedang-iris-benchmark resources, not at
# production.

# --- AWS / region -----------------------------------------------------------
IRIS_BENCHMARK_AWS_REGION=ap-northeast-2
# Optional named profile for the operator identity. Do not put keys here.
IRIS_BENCHMARK_AWS_PROFILE=

# --- Terraform resource naming ---------------------------------------------
IRIS_BENCHMARK_NAME_PREFIX=codedang-iris-benchmark
IRIS_BENCHMARK_BENCHMARK_GENERATION=v1

# --- Snapshot discovery (read-only) ----------------------------------------
IRIS_BENCHMARK_SOURCE_DB_IDENTIFIER=terraform-20250506182211604800000001
# Verified read-only in ap-northeast-2 on 2026-09-25. Re-run discovery before
# creating a later benchmark generation.
IRIS_BENCHMARK_SOURCE_SNAPSHOT_IDENTIFIER=rds:terraform-20250506182211604800000001-2026-09-24-16-05
IRIS_BENCHMARK_SOURCE_SNAPSHOT_CREATED_AT=2026-09-24T16:05:07.494000+00:00
IRIS_BENCHMARK_SOURCE_SNAPSHOT_ARN=arn:aws:rds:ap-northeast-2:219857217698:snapshot:rds:terraform-20250506182211604800000001-2026-09-24-16-05

# --- Dedicated benchmark RDS -----------------------------------------------
IRIS_BENCHMARK_RDS_IDENTIFIER=codedang-iris-benchmark
IRIS_BENCHMARK_RDS_DB_NAME=skkuding
IRIS_BENCHMARK_RDS_PORT=5433
IRIS_BENCHMARK_RDS_ADDRESS=codedang-iris-benchmark.cvgvmoteakvb.ap-northeast-2.rds.amazonaws.com
# Secret identifiers only; values are fetched at runtime and never stored here.
IRIS_BENCHMARK_RDS_MASTER_SECRET_ID=arn:aws:secretsmanager:ap-northeast-2:219857217698:secret:rds!db-6135be5d-9383-45d8-b926-3dbbe303a663-6ul22q
IRIS_BENCHMARK_RDS_READONLY_SECRET_ID=arn:aws:secretsmanager:ap-northeast-2:219857217698:secret:codedang-iris-benchmark/readonly-db-NWBJ3G
IRIS_BENCHMARK_DB_READONLY_ROLE=benchmark_ro

# --- Sanitized fixtures and dedicated S3 bucket ----------------------------
IRIS_BENCHMARK_S3_BUCKET=codedang-iris-benchmark-testcases
IRIS_BENCHMARK_S3_TESTCASE_PREFIXES=568,569,570
IRIS_BENCHMARK_FIXTURES_DIR=fixtures
IRIS_BENCHMARK_FIXTURE_MANIFEST=fixtures/manifest.json
IRIS_BENCHMARK_IAM_POLICY_NAME=codedang-iris-benchmark-testcase-read
IRIS_BENCHMARK_S3_READ_ROLE_ARN=arn:aws:iam::219857217698:role/codedang-iris-benchmark-testcase-read
IRIS_BENCHMARK_S3_UPLOAD_ROLE_ARN=arn:aws:iam::219857217698:role/codedang-iris-benchmark-testcase-upload

# --- Iris image -------------------------------------------------------------
# Default selector for the benchmark baseline. The controller resolves it to an
# immutable manifest digest before execution and records that digest in the run
# plan. This reviewed digest is a cache and must be re-resolved before each run.
IRIS_BENCHMARK_IRIS_IMAGE=ghcr.io/skkuding/codedang-iris:stage
IRIS_BENCHMARK_IRIS_IMAGE_DIGEST=sha256:39b743d6e1ffb1efaa18f42b509c2017b91c11976971c862beafda2ae1521250
